; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="como_fazer_um_jogo"
run/main_scene="res://scenes/main/level_1.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Global="*res://scripts/Global.gd"
BackgroundMusic="*res://scenes/background_music.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"Aluno 1": "res://resources/dialog/timelines/Aluno 1.dch",
"brad": "res://resources/dialog/chars/brad.dch",
"prof_sabio": "res://resources/dialog/chars/prof_sabio.dch"
}
directories/dtl_directory={
"aula_1_prof_sabio": "res://resources/dialog/timelines/aula_1_prof_sabio.dtl",
"introduction": "res://resources/dialog/timelines/introduction.dtl",
"nomeqvcquiser": "res://resources/dialog/timelines/nomeqvcquiser.dtl",
"professor_apresenta_disciplina": "res://resources/dialog/timelines/professor_apresenta_disciplina.dtl"
}
layout/style_list=["res://resources/dialog/chars/bubble.tres"]
layout/default_style="res://resources/dialog/chars/bubble.tres"
variables={
"game_name": ""
}
text/letter_speed=0.02
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/join_default_wait=true
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
glossary/default_case_sensitive=true
text/input_action="dialogic_default_action"
text/autocolor_names=true
glossary/glossary_files=["res://resources/dialog/default_glossary.tres"]
translation/enabled=false
translation/original_locale="pt_BR"
translation/file_mode=1
translation/translation_folder="res://resources/dialog/translations"
translation/save_mode=0
translation/add_separator=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
mouse_cursor/custom_image="res://resources/UI/pointer_scifi_b.png"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://resources/": "orange",
"res://scenes/": "blue",
"res://scripts/": "green"
}

